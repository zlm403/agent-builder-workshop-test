// Prisma schema — Sprint 1 共用课堂底座核心实体
// 后续 Sprint 2/3 的 AgentProject / AgentConfigVersion / SourceDocument /
// WorkflowDefinition / AIRun / Evaluation / PeerFeedback / PublishedWork /
// EnrollmentEvent 将在后续迁移中加入，保持版本不可覆盖与前后对比约束。

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 课程模板：版本 + 模块顺序（JSON 驱动，不硬编码页面）
model CourseTemplate {
  id        String   @id @default(uuid())
  version   String
  name      String
  subtitle  String?
  modules   Json // CourseTemplateData 对象（含 modules: ModuleConfig[]）
  status    String   @default("active") // draft | active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  ClassSession[]

  @@unique([version])
}

/// 某一场具体课堂
model ClassSession {
  id              String   @id @default(uuid())
  templateId      String
  teacherId       String   @default("teacher-default")
  inviteCode      String   @unique // 6 位入场码
  status          String   @default("pending") // pending|active|paused|ended
  currentModuleId String?
  moduleLocked    Boolean  @default(false)
  moduleSubState  String?  // A03 子状态：running（第二轮进行中）| compare（已揭晓前后变化）；其它环节为 null
  moduleStartedAt DateTime? // 进入当前计时节点的真实时刻（用于倒计时对齐，迟到/二次进入自动跟随）
  scheduledStartAt DateTime? // 设定的开课时间（教师可设定，入场倒计时对准此时间，到时归零）
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template        CourseTemplate @relation(fields: [templateId], references: [id])
  participants    Participant[]
  invitations     ClassInvitation[]
  moduleProgress  ModuleProgress[]
  a0Screenings    A0Screening[]
  a0News          A0New[]
  a1Avatars       A1Avatar[]
  p2SiteEntries   P2SiteEntry[]
  p3GrowGames     P3GrowGame[]
  entryThoughts   EntryThought[]
  auditLogs       AuditLog[]
  agentCompanies  AgentCompany[]
  companyFeedbacks CompanyFeedback[]
  finaleState     FinaleState?

  @@index([inviteCode])
  @@index([teacherId])
}

/// 匿名学生身份
model Participant {
  id          String   @id @default(uuid())
  sessionId   String
  anonymousId String   @unique // 如 "A023"
  nickname    String?  // 备用昵称（旧逻辑），新流程使用微信昵称
  wechatName  String?  // 微信网页授权获取的微信昵称（与 anonymousId 一一对应，仅用于销售跟进）
  wechatOpenid String? @unique // 微信 openid（网页授权唯一标识，用于去重/重复扫码识别）
  resumeToken String   @unique // 断线恢复令牌
  deviceInfo  Json?
  connected   Boolean  @default(true)
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  session         ClassSession    @relation(fields: [sessionId], references: [id])
  moduleProgress  ModuleProgress[]
  a0Screenings    A0Screening[]
  a0News          A0New[]
  a1Avatars       A1Avatar[]
  p2SiteEntries   P2SiteEntry[]
  p3GrowGames     P3GrowGame[]
  entryThoughts   EntryThought[]
  consentRecords  ConsentRecord[]

  @@index([sessionId])
}

/// 入场暖场：学生扫码进入后写下的 AI 认知想法（匿名，用于大屏弹幕）
model EntryThought {
  id           String   @id @default(uuid())
  sessionId    String
  participantId String
  anonymousId  String
  text         String // 想法内容（已过滤）
  createdAt    DateTime @default(now())

  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// 模块进度（每名学生每模块一条）
model ModuleProgress {
  id           String   @id @default(uuid())
  participantId String
  sessionId    String
  moduleId     String
  status       String   @default("pending") // pending|entered|submitted|completed|stuck|skipped
  submittedAt  DateTime?
  completedAt  DateTime?
  data         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participant Participant   @relation(fields: [participantId], references: [id])
  session     ClassSession  @relation(fields: [sessionId], references: [id])

  @@unique([participantId, moduleId])
  @@index([sessionId, moduleId, status])
}

/// 授权记录
model ConsentRecord {
  id            String   @id @default(uuid())
  participantId String
  consentType   String // privacy | screen_display | work_publish
  granted       Boolean
  ipAddress     String?
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([participantId, consentType])
}

/// 课堂个人邀请码（一人一码，扫码/输入后签到，不可复用）
model ClassInvitation {
  id                  String        @id @default(uuid())
  sessionId           String        @map("session_id")
  code                String
  used                Boolean       @default(false)
  usedByParticipantId String?       @map("used_by_participant_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, code])
  @@index([sessionId])
  @@map("class_invitations")
}

/// 审计日志
model AuditLog {
  id        String   @id @default(uuid())
  sessionId String
  actor     String // teacher | system | student:{anonymousId}
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
}

/// （一人公司 · 多 Agent 协同）：每个学生搭建的 4-Agent 产品，发布后供他人访问体验
model AgentCompany {
  id              String   @id @default(uuid())
  sessionId       String
  ownerAnonymousId String // 发布者匿名号（与 Participant.anonymousId 对应）
  ownerName       String? // 发布者昵称（微信名），仅用于展示
  scene           String // study | shopping | fun
  name            String // 公司名（学生自拟）
  agents          Json // 4 个 Agent 的属性卡：[{ role, nickname, personality, duty, boundary, rules, handoff }]
  round           Int      @default(0) // 所属体验轮次
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  feedbacks       CompanyFeedback[]

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, round])
}

/// 课堂状态：是否进入、当前轮次、是否开放（接受发布/访问）
model FinaleState {
  sessionId String @id
  active    Boolean @default(false)
  round     Int     @default(0)
  open      Boolean @default(false) // 是否开放发布与访问
  updatedAt DateTime @updatedAt

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

/// 访问反馈（他人体验某产品后提交）
model CompanyFeedback {
  id                String   @id @default(uuid())
  sessionId         String
  companyId         String
  visitorAnonymousId String
  rating            Int? // 1-5
  comment           String?
  createdAt         DateTime @default(now())

  company AgentCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([sessionId])
}

/// A0 新版（三问 + 关系题）：匿名收集每位学员对 AI 的三个真实回答与"工具/伙伴"关系投票
model A0New {
  id           String   @id @default(uuid())
  sessionId    String
  anonymousId  String
  participantId String
  answers      Json // { q1, q2, q3 } 三问回答
  relation     String? // "tool" | "partner"（关系题唯一投票）
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, anonymousId])
  @@index([sessionId])
  @@map("a0_new")
}

/// A1 数字分身：六步对话进度 + LLM 生成的画像/Skill + 方案 + 作品迭代
model A1Avatar {
  id           String   @id @default(uuid())
  sessionId    String
  anonymousId  String
  participantId String
  step         Int      @default(1) // 1..6 当前完成到第几步（大屏点亮格数）
  dream        String?  // 步1：梦想
  path         String?  // 步2：路径 A/B/C
  chatLog      Json?    // 步3：创建分身的多轮对话 [{ role, content }]
  profileJson  Json?    // LLM 生成的数字分身画像 { traits, style, boundaries, labels }
  skillText    String?  // LLM 生成的 Skill 文本
  task         String?  // 步4：定义任务（朋友圈表达主题）
  planChoice   String?  // 步5：选中的方案
  drafts       Json?    // 步6：3 个版本草稿 [{ version, text }]
  feedback     String?  // 对草稿的 LLM 反馈
  finalText    String?  // 定稿作品
  submittedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, anonymousId])
  @@index([sessionId])
  @@map("a1_avatar")
}

/// 方案二：快速入门网站（site_entry）六步流程 + LLM 生成的领域骨架/网站草稿/发布作品
model P2SiteEntry {
  id            String   @id @default(uuid())
  sessionId     String
  anonymousId   String
  participantId String
  step          Int      @default(1) // 1..6 当前完成到第几步（大屏点亮格数）
  field         String?  // 步1：选择的领域
  entryTask     String?  // 步2：入场任务（帮谁 / 完成什么）
  skeleton      String?  // 步3：AI 建立的最小知识骨架
  keyDiff       String?  // 步4：三个关键区别与判断标准
  sitePlan      String?  // 步5：五屏网站路径设计
  chatLog       Json?    // 全程多轮对话 [{ role, content }]
  siteCode      String?  // LLM 生成的手机网站 HTML
  testNote      String?  // 步6：小白测试结果
  finalWork     String?  // 发布版网址/描述
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, anonymousId])
  @@index([sessionId])
  @@map("p2_site_entry")
}

/// 方案三：养成游戏（grow_game）六步流程 + LLM 生成的游戏系统/草稿/发布作品
model P3GrowGame {
  id            String   @id @default(uuid())
  sessionId     String
  anonymousId   String
  participantId String
  step          Int      @default(1) // 1..6 当前完成到第几步（大屏点亮格数）
  objectName    String?  // 步1：想养成的对象
  growthDef     String?  // 步2：什么叫成长（成长观）
  coreRules     String?  // 步3：核心属性与冲突机制
  events        String?  // 步4：成长事件设计
  endings       String?  // 步5：不同结局设计
  chatLog       Json?    // 全程多轮对话 [{ role, content }]
  gameCode      String?  // LLM 生成的手机游戏 HTML
  testNote      String?  // 步6：试玩检查结果
  finalWork     String?  // 发布版描述
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, anonymousId])
  @@index([sessionId])
  @@map("p3_grow_game")
}

/// A0 环节（AI 面试 · 应聘自检）：匿名收集每位学员的真实回答、兴趣信号与当前 AI 标签
model A0Screening {
  id               String   @id @default(uuid())
  sessionId        String
  anonymousId      String
  participantId    String
  answer           String // 学员真实写下的第一问回答
  wordCount        Int      @default(0)
  aiLabel          String   // tool_user | task_solver | app_creator（基于本次回答的“当前标签”）
  followupQuestion String?  // 第二问：AI 针对性追问
  followupAnswer   String?  // 学员对追问的回答
  judgmentJson     Json?    // 第一问判定（含 hasTools/hasTask/hasResult/hasAction/feedback/followup）
  followupJson     Json?    // 第二问后的最终判定
  interestSignal   Int      @default(0) // 兴趣信号 0-5（由回答长度与关键词推断，供销售跟进）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, anonymousId])
  @@index([sessionId])
}

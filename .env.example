# ===== Supabase PostgreSQL 连接串 =====
# 在 Supabase 控制台 → Project Settings → Database → Connection pooling 复制
# 必须用 Session Pooler 的 5432 端口（host 形如 aws-0-<区域>.pooler.supabase.com）
# 不要用 6543 事务池化器（Prisma 迁移会卡死），也不要用 db.<ref>.supabase.co 直连（IPv6 不可达）
# 区域必须选对（本项目东京 ap-northeast-1），用户名是 postgres.<项目ref>
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ===== 前端基础地址（用于生成入场二维码链接）=====
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ===== 生产实时同步选项（Sprint1 默认用 SSE，无需配置；多实例部署时启用 Supabase Realtime）=====
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ===== 真实 LLM（AI 对话）接入 =====
# 不配置则系统自动走“离线 mock 回复”（固定模板，仅用于演示流程，不会真实推理）。
# 配置后，教师端/学生端/大屏的所有 AI 对话会切换到真实模型（OpenAI 兼容接口）。
# 把下面三行复制到 .env，填入你的密钥后重启 dev server 即可生效。
#
# LLM_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
# LLM_BASE_URL="https://api.openai.com/v1"   # 用国产兼容模型可改为对应地址，如 https://api.deepseek.com/v1
# LLM_MODEL="gpt-4o-mini"                      # 对应模型名，如 deepseek-chat

# ===== 微信网页授权（自动收集学员微信昵称，供销售跟进定位到人）=====
# 不配置则二维码为普通入场链接，微信昵称留空（销售简报显示匿名编号）。
# 配置后：扫码二维码 = 微信授权链接 → 学员在微信内同意 → 自动回传微信昵称，
# 与课堂内匿名编号一一对应，销售简报中显示「微信昵称(匿名编号)」。
# 前置条件：
#   1) 已认证的微信公众号（服务号）AppID / AppSecret
#   2) 公众号后台「网页授权域名」配置为本站公网 HTTPS 域名
#   3) 该域名能访问 /api/wechat/oauth/callback
# 把下面两行复制到 .env，填入后重启 dev server 即可生效。
#
# WECHAT_APPID="wxXXXXXXXXXXXXXXXX"
# WECHAT_APPSECRET="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

